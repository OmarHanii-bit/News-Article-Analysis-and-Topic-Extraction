# ---------------------------------------------------------------------------
# Example environment variables for the News Article Big Data pipeline.
# Copy to `.env` (or export in your shell) and adjust as needed.
# Every variable is OPTIONAL: the code falls back to the documented defaults.
# ---------------------------------------------------------------------------

# MongoDB connection (src/mongo_loader.py, src/dashboard.py)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=news_analytics

# Spark execution (src/spark_pipeline.py, run_all.py)
# Defaults: master=local[*], driver=4g, executor=4g
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

# Hive partition override (src/hadoop/hive_analytics.py); otherwise derived from data
# HIVE_PARTITION_YEAR=2025
# HIVE_PARTITION_MONTH=12

# Kaggle ingestion (src/ingest_kaggle_real.py) — only needed to ingest a real
# Kaggle "All the News" CSV. Never commit real credentials.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Windows console / notebook Unicode safety
PYTHONIOENCODING=utf-8
