    {
      "query_name": "topic_term_join",
      "business_question": "Topic keyword importance via JOIN of topics with the MapReduce term counts",
      "sql": "SELECT t.topic_label, COUNT(DISTINCT tc.term) AS matched_terms, SUM(tc.cnt) AS total_keyword_freq FROM topics t JOIN term_counts tc ON (t.term = tc.term) GROUP BY t.topic_label ORDER BY total_keyword_freq DESC;",
