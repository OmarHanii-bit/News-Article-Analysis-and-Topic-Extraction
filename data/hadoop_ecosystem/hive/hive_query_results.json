    {
      "query_name": "sentiment_ranking",
      "business_question": "Sentiment ranking of publishers within each topic (RANK window function)",
      "sql": "WITH pub_topic AS (SELECT topic_label, publication, AVG(sentiment_polarity) AS avg_sent FROM news_articles GROUP BY topic_label, publication) SELECT topic_label, publication, ROUND(avg_sent,4) AS avg_sent, RANK() OVER (PARTITION BY topic_label ORDER BY avg_sent DESC) AS rnk FROM pub_topic ORDER BY topic_label, rnk LIMIT 30;",
      "status": "ok",
      "rows_scanned": 6000,
      "columns": [
        "topic_label",
        "publication",
        "avg_sent",
        "rnk"
